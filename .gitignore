.DS_Store
.claude/
.build/
.swiftpm/
DerivedData/
*.xcodeproj
Package.resolved

# Generated kernel artifacts (regenerated on every build by SPM plugin).
# Ignore everything in Generated/ except .gitkeep so the directory
# survives a fresh clone before iron-emit runs.
Sources/IronSwift/Resources/kernels.metallib
# Overlay metallib (Path B fuses + fast NVFP4 eidx qdot) — rebuilt by
# scripts/link-extra-metals.sh after iron emit; sources in kernel_overlays/.
Sources/IronSwift/Resources/kernels_extra.metallib
Sources/IronSwift/Resources/manifest.json
# `iron build --emit all` regenerates iron_*.metal here; those stay ignored.
# Hand-written `butter_*.metal` MPP live-compile sources (PSOCache
# `liveCompileMppFunction` reads Resources/kernels/<name>.metal at runtime;
# see Sources/IronSwift/PSOCache.swift) are NOT emitted by iron and must be
# tracked, or a fresh clone silently loses working kernels (e.g. T13/T22 NAX
# gather QMM spikes were previously invisible to git under the blanket
# ignore below).
Sources/IronSwift/Resources/kernels/*
!Sources/IronSwift/Resources/kernels/butter_*.metal
Sources/IronSwift/Generated/*
!Sources/IronSwift/Generated/.gitkeep

# Local model files (downloaded checkpoints land in /Models at the repo
# root; Sources/ButterSwift/Models/ is the family-file source directory and IS
# tracked).
/Models/
*.safetensors
*.gguf
planning/session-plan.md

# Per-run output from scripts/integration-bisect.sh — the script tool
# itself stays tracked; only the log dump is local.
planning/integration-bisect-logs/